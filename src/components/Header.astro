---
interface Props {
  /** Home page: the header lies over the hero band and uses the reversed logo. */
  onBand?: boolean;
}
const { onBand = false } = Astro.props;
---

<header class:list={['site-header', { 'on-band': onBand }]}>
  <div class="wrap">
    <a class="logo" href="/" aria-label="Manticwise, home">
      {
        onBand ? (
          <img src="/assets/m-lockup-onecolour-reversed.svg" alt="Manticwise" width="148" height="25" />
        ) : (
          <picture>
            <source srcset="/assets/m-lockup-onecolour-reversed.svg" media="(prefers-color-scheme: dark)" />
            <img src="/assets/m-lockup-onecolour.svg" alt="Manticwise" width="148" height="25" />
          </picture>
        )
      }
    </a>
  </div>
</header>
