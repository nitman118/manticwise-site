---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  socialDescription?: string;
  ogType?: 'website' | 'article';
  image?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Home page: header over the hero band. */
  onBand?: boolean;
  /** Pages that show the AI-generated art. */
  imageCredit?: boolean;
}
const { onBand = false, imageCredit = false, ...head } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead {...head}><slot name="head" /></BaseHead>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header onBand={onBand} />
    <main id="main">
      <slot />
    </main>
    <Footer imageCredit={imageCredit} />
  </body>
</html>
