---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Manticwise" description="This page does not exist on manticwise.com." noindex>
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">This page does not exist, or it has moved.</p>
      <a class="button" href="/">Go to the home page</a>
    </div>
  </section>
</Base>
